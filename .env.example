# ============================================================================
# BMO Robot Project - Environment Configuration Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# Never commit .env to version control!
# ============================================================================

# --- Main Brain: LM Studio on Windows Laptop ---
# Replace with your Windows laptop's Wi-Fi IPv4 address (run `ipconfig` in PowerShell).
# Use 127.0.0.1 when running/testing scripts directly on the laptop itself.
LAPTOP_IP=127.0.0.1
LMSTUDIO_PORT=1234

# Model identifier loaded in LM Studio (Llama 3.1 8B Instruct Q4_K_M).
# Leave empty to automatically use the first model returned by GET /v1/models.
LMSTUDIO_MODEL=

# --- Fallback Brain: Ollama in Termux on Samsung Galaxy A07 ---
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=tinyllama

# --- BMO Face HTTP Server (runs locally on the phone/laptop) ---
FACE_HOST=127.0.0.1
FACE_PORT=8080

# --- Body Controller: ESP32-C3 Mini over Wi-Fi HTTP (Disabled for phone-only build) ---
ESP32_ENABLED=false
ESP32_IP=192.168.1.150
ESP32_PORT=80

# --- Voice Tuning (Termux:API & Laptop testing) ---
# Higher pitch (~1.3 - 1.5) gives BMO a sweet, childlike voice.
TTS_PITCH=1.35
TTS_RATE=1.05
STT_TIMEOUT=12
# Set USE_TEXT_INPUT=true on the laptop or when testing without a microphone.
USE_TEXT_INPUT=false
