#ifndef BMO_SECRETS_H
#define BMO_SECRETS_H

// Fill in your 2.4 GHz Wi-Fi network name and password
// (Note: ESP32-C3 only supports 2.4 GHz Wi-Fi, not 5 GHz-only networks)
#define WIFI_SSID     "YOUR_2.4GHZ_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

#endif // BMO_SECRETS_H
